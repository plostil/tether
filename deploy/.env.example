# Copy to repo-root .env and fill in. Used by docker-compose.yml.

# Domain that resolves to this host; Caddy gets a TLS cert for it.
# Clients connect to wss://$BROKER_DOMAIN/signal
BROKER_DOMAIN=signal.example.com

# Domain (or IP) clients reach the TURN server at. Often the same host.
TURN_DOMAIN=turn.example.com

# This host's PUBLIC IP — coturn advertises it as the relay address.
EXTERNAL_IP=203.0.113.10

# Long random shared secret for TURN REST credentials. Generate with:
#   openssl rand -hex 32
# MUST match between the broker (TURN_SECRET) and coturn (--static-auth-secret);
# compose wires both from this one value.
TURN_SECRET=replace-with-openssl-rand-hex-32
