# Normalize line endings — this repo is developed across Windows, Android, and
# POSIX CI. Text is LF in the repo; Git converts on checkout per-platform.
* text=auto eol=lf

# Windows-native project files keep CRLF.
*.sln text eol=crlf
*.vcxproj text eol=crlf
*.manifest text eol=crlf

# Binary
*.png binary
*.jpg binary
*.keystore binary
*.jks binary
